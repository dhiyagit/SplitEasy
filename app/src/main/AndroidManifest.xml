        <activity
            android:name=".MainMenuActivity"
            android:exported="false" />

        <activity
            android:name=".HomeActivity"
            android:exported="false" />

        <activity
            android:name=".EventActivity"
            android:exported="false" />

        <activity
            android:name=".TripPlannerActivity"
            android:exported="false" />

        <activity
            android:name=".TripItineraryActivity"
            android:exported="false" />

        <activity
            android:name=".TripBudgetDetailActivity"
            android:exported="false" />

        <activity
            android:name=".TripBudgetListActivity"
            android:exported="false" />

        <activity
            android:name=".PartyEventPlannerActivity"
            android:exported="false" />

        <activity
            android:name=".EventListForGuestsActivity"
            android:exported="false" />

        <activity
            android:name=".GuestListRsvpActivity"
            android:exported="false" />

        <activity
            android:name=".CalendarPollsActivity"
            android:exported="false" />

        <activity
            android:name=".EventFeatureActivity"
            android:exported="false" />

        <activity
            android:name=".AnnouncementsActivity"
            android:exported="false" />

        <activity
            android:name=".BirthdaysActivity"
            android:exported="false" />

        <activity
            android:name=".ShoppingListActivity"
            android:exported="false" />

        <activity
            android:name=".SubscriptionsActivity"
            android:exported="false" />

        <activity
            android:name=".CreateGroupActivity"
            android:exported="false" />

        <activity
            android:name=".GroupDetailActivity"
            android:exported="false" />

        <activity
            android:name=".AddExpenseActivity"
            android:exported="false" />

        <activity
            android:name=".RecordSettlementActivity"
            android:exported="false" />

        <activity
            android:name=".GroupInsightsActivity"
            android:exported="false" />

        <activity
            android:name=".ProfileActivity"
            android:exported="false" />

        <activity
            android:name=".RemindersActivity"
            android:exported="false" />

        <activity
            android:name=".PinLockActivity"
            android:exported="false" />

        <activity
            android:name=".ForgotPinActivity"
            android:exported="false" />

        <activity
            android:name=".ChangePinActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>
    </application>
</manifest>
