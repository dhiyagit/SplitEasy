<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#F5F7FA">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Change App PIN"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#1A365D"/>

    <EditText
        android:id="@+id/newPinInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="New 4-Digit PIN"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:textColorHint="#4A5568"
        android:inputType="numberPassword"
        android:maxLength="4"
        android:layout_marginTop="24dp"/>

    <EditText
        android:id="@+id/confirmNewPinInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Confirm New 4-Digit PIN"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:textColorHint="#4A5568"
        android:inputType="numberPassword"
        android:maxLength="4"
        android:layout_marginTop="12dp"/>

    <Button
        android:id="@+id/changePinButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Update PIN"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"/>

</LinearLayout>
