<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="50dp"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/groupTitleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Group Details"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#1A365D"/>

        <!-- Add Member Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Member by Email"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="18dp"
            android:textColor="#2D3748"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/memberEmailInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="user@email.com"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:textColorHint="#4A5568"
                android:inputType="textEmailAddress"/>

            <Button
                android:id="@+id/addMemberButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- Members Section with Independent Scrolling -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Group Members (Tap to Remove)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="18dp"
            android:textColor="#2D3748"/>

        <ScrollView
            android:id="@+id/membersScrollView"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="6dp"
            android:background="#FFFFFF"
            android:padding="4dp">

            <LinearLayout
                android:id="@+id/membersContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </ScrollView>

        <!-- Action Buttons for Expense & Settlement -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/addExpenseButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Add Expense"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/recordSettlementButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Settle Up"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp"/>

            <Button
                android:id="@+id/insightsButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Insights"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

        <!-- Member Balances Section with Independent Scrolling -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Member Net Balances"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:textColor="#2D3748"/>

        <ScrollView
            android:id="@+id/balancesScrollView"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_marginTop="6dp"
            android:background="#FFFFFF"
            android:padding="4dp">

            <LinearLayout
                android:id="@+id/balancesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </ScrollView>

        <!-- Suggested Debts Section with Independent Scrolling -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Suggested Debts"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:textColor="#2D3748"/>

        <ScrollView
            android:id="@+id/suggestedDebtsScrollView"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="6dp"
            android:background="#FFFFFF"
            android:padding="4dp">

            <LinearLayout
                android:id="@+id/suggestedDebtsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </ScrollView>

        <!-- Transaction History Section with Independent Scrolling -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Transaction History"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:textColor="#2D3748"/>

        <ScrollView
            android:id="@+id/historyScrollView"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="6dp"
            android:background="#FFFFFF"
            android:padding="4dp">

            <LinearLayout
                android:id="@+id/historyContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </ScrollView>

        <!-- Delete Group Button -->
        <Button
            android:id="@+id/deleteGroupButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delete Group"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="32dp"/>

    </LinearLayout>
</ScrollView>
