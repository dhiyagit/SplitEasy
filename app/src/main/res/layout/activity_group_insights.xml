<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Group Spending Insights"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#7C3AED"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Analyze expenses, spending categories and member contributions."
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#4B5563"
            android:layout_marginTop="6dp"/>

        <!-- Total Spending Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/rounded_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Group Expenses"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#4B5563"/>

            <TextView
                android:id="@+id/totalSpendingTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0.00"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#7C3AED"
                android:layout_marginTop="6dp"/>
        </LinearLayout>

        <!-- Highest Spending Category Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/rounded_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Highest Spending Category"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#4B5563"/>

            <TextView
                android:id="@+id/highestCategoryTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="None"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#111827"
                android:layout_marginTop="6dp"/>
        </LinearLayout>

        <!-- Monthly Comparison Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/rounded_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Monthly Spending Comparison"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#4B5563"/>

            <TextView
                android:id="@+id/monthlyComparisonTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Comparing with previous month..."
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#111827"
                android:layout_marginTop="6dp"/>
        </LinearLayout>

        <!-- Category Breakdown Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Category Breakdown"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#7C3AED"
            android:layout_marginTop="24dp"/>

        <LinearLayout
            android:id="@+id/categoryBreakdownContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp"/>

        <!-- Member Spending Summary Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Member Spending Summary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#7C3AED"
            android:layout_marginTop="24dp"/>

        <LinearLayout
            android:id="@+id/memberInsightsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="32dp"/>

    </LinearLayout>
</ScrollView>
