<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#F5F7FA">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SplitEasy"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#1A365D"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter 4-Digit App PIN"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        android:textColor="#2D3748"/>

    <!-- PIN Display Indicators (4 digits) -->
    <TextView
        android:id="@+id/pinDotsTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="○ ○ ○ ○"
        android:textSize="28sp"
        android:textStyle="bold"
        android:letterSpacing="0.3"
        android:layout_marginTop="24dp"
        android:textColor="#1A365D"/>

    <TextView
        android:id="@+id/errorTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#C53030"
        android:layout_marginTop="12dp"/>

    <!-- Numeric Keypad Grid -->
    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:rowCount="4"
        android:columnCount="3"
        android:layout_marginTop="20dp"
        android:alignmentMode="alignMargins">

        <Button android:id="@+id/btn1" android:text="1" android:textSize="20sp" android:textStyle="bold" android:layout_width="80dp" android:layout_height="60dp" android:layout_margin="6dp"/>
        <Button android:id="@+id/btn2" android:text="2" android:textSize="20sp" android:textStyle="bold" android:layout_width="80dp" android:layout_height="60dp" android:layout_margin="6dp"/>
        <Button android:id="@+id/btn3" android:text="3" android:textSize="20sp" android:textStyle="bold" android:layout_width="80dp" android:layout_height="60dp" android:layout_margin="6dp"/>

        <Button android:id="@+id/btn4" android:text="4" android:textSize="20sp" android:textStyle="bold" android:layout_width="80dp" android:layout_height="60dp" android:layout_margin="6dp"/>
        <Button android:id="@+id/btn5" android:text="5" android:textSize="20sp" android:textStyle="bold" android:layout_width="80dp" android:layout_height="60dp" android:layout_margin="6dp"/>
        <Button android:id="@+id/btn6" android:text="6" android:textSize="20sp" android:textStyle="bold" android:layout_width="80dp" android:layout_height="60dp" android:layout_margin="6dp"/>

        <Button android:id="@+id/btn7" android:text="7" android:textSize="20sp" android:textStyle="bold" android:layout_width="80dp" android:layout_height="60dp" android:layout_margin="6dp"/>
        <Button android:id="@+id/btn8" android:text="8" android:textSize="20sp" android:textStyle="bold" android:layout_width="80dp" android:layout_height="60dp" android:layout_margin="6dp"/>
        <Button android:id="@+id/btn9" android:text="9" android:textSize="20sp" android:textStyle="bold" android:layout_width="80dp" android:layout_height="60dp" android:layout_margin="6dp"/>

        <Button android:id="@+id/btnClear" android:text="C" android:textSize="18sp" android:textStyle="bold" android:layout_width="80dp" android:layout_height="60dp" android:layout_margin="6dp"/>
        <Button android:id="@+id/btn0" android:text="0" android:textSize="20sp" android:textStyle="bold" android:layout_width="80dp" android:layout_height="60dp" android:layout_margin="6dp"/>
        <Button android:id="@+id/btnDelete" android:text="⌫" android:textSize="18sp" android:textStyle="bold" android:layout_width="80dp" android:layout_height="60dp" android:layout_margin="6dp"/>

    </GridLayout>

    <TextView
        android:id="@+id/forgotPinLink"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Forgot PIN?"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#2457C5"
        android:layout_marginTop="20dp"/>

</LinearLayout>
