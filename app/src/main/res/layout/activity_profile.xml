<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UPI Settings"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#1A365D"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save your UPI ID for GPay settlements."
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#4A5568"
            android:layout_marginTop="16dp"/>

        <EditText
            android:id="@+id/upiIdInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Your UPI ID (e.g. name@okaxis)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:textColorHint="#4A5568"
            android:inputType="textEmailAddress"
            android:layout_marginTop="12dp"/>

        <Button
            android:id="@+id/saveUpiButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save UPI ID"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"/>

        <Button
            android:id="@+id/changePinButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Change App PIN"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"/>

    </LinearLayout>
</ScrollView>
