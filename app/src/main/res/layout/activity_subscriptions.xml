<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F5F7FA">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Subscriptions &amp; Members"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#1A365D"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp">

        <EditText
            android:id="@+id/subNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Subscription Name (e.g. Netflix, Spotify)"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:textColorHint="#4A5568"
            android:inputType="text"/>

        <EditText
            android:id="@+id/subCostInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Cost (₹)"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:textColorHint="#4A5568"
            android:inputType="numberDecimal"
            android:layout_marginTop="6dp"/>

        <EditText
            android:id="@+id/subRenewalInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Renewal Date (YYYY-MM-DD)"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:textColorHint="#4A5568"
            android:inputType="date"
            android:layout_marginTop="6dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Paying Member:"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#2D3748"
            android:layout_marginTop="8dp"/>

        <Spinner
            android:id="@+id/subPayerSpinner"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/rounded_spinner_bg"
            android:paddingHorizontal="12dp"
            android:layout_marginTop="4dp"/>

        <Button
            android:id="@+id/createSubButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Subscription"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>
    </LinearLayout>

    <ListView
        android:id="@+id/subscriptionsListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:background="#FFFFFF"
        android:padding="8dp"/>

</LinearLayout>
