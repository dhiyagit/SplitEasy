<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA">

    <ScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/itineraryTripTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trip Itinerary"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#1A365D"/>

            <!-- Add Itinerary Form -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add Itinerary Item"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#2D3748"/>

                <EditText
                    android:id="@+id/itineraryTitleInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Activity Title (e.g. Beach Visit)"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:textColorHint="#4A5568"
                    android:inputType="text"
                    android:layout_marginTop="8dp"/>

                <EditText
                    android:id="@+id/itineraryDescInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Description / Notes"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:textColorHint="#4A5568"
                    android:inputType="text"
                    android:layout_marginTop="6dp"/>

                <EditText
                    android:id="@+id/itineraryDateInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Date (YYYY-MM-DD)"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:textColorHint="#4A5568"
                    android:inputType="date"
                    android:layout_marginTop="6dp"/>

                <Button
                    android:id="@+id/addItineraryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Add Itinerary Item"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp"/>
            </LinearLayout>

            <!-- Itinerary List -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Itinerary Schedule (Long-press to Delete)"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1A365D"
                android:layout_marginTop="20dp"/>

            <ListView
                android:id="@+id/itineraryListView"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_marginTop="6dp"
                android:background="#FFFFFF"
                android:padding="4dp"
                android:layout_marginBottom="24dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <include layout="@layout/layout_bottom_nav"/>

</LinearLayout>
