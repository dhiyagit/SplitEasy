<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA">

    <ScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✈️ Trip Planner"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#1A365D"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create and manage your group trips &amp; itineraries."
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#4A5568"
                android:layout_marginTop="6dp"/>

            <!-- Create / Edit Trip Form -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginTop="16dp">

                <TextView
                    android:id="@+id/formTitleTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Create New Trip"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#2D3748"/>

                <EditText
                    android:id="@+id/tripNameInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Trip Name (e.g. Goa Vacation)"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:textColorHint="#4A5568"
                    android:inputType="text"
                    android:layout_marginTop="8dp"/>

                <EditText
                    android:id="@+id/destinationInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Destination"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:textColorHint="#4A5568"
                    android:inputType="text"
                    android:layout_marginTop="6dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <EditText
                        android:id="@+id/startDateInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Start (YYYY-MM-DD)"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:textColorHint="#4A5568"
                        android:inputType="date"/>

                    <EditText
                        android:id="@+id/endDateInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="End (YYYY-MM-DD)"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:textColorHint="#4A5568"
                        android:inputType="date"
                        android:layout_marginStart="6dp"/>
                </LinearLayout>

                <EditText
                    android:id="@+id/totalBudgetInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Total Budget (₹)"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:textColorHint="#4A5568"
                    android:inputType="numberDecimal"
                    android:layout_marginTop="6dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <Button
                        android:id="@+id/saveTripButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Create Trip"
                        android:textSize="15sp"
                        android:textStyle="bold"/>

                    <Button
                        android:id="@+id/cancelEditButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cancel"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:backgroundTint="#718096"
                        android:textColor="#FFFFFF"
                        android:visibility="gone"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Trips List -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Trips (Tap to Manage Itinerary | Long-press to Delete/Edit)"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1A365D"
                android:layout_marginTop="20dp"/>

            <ListView
                android:id="@+id/tripsListView"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_marginTop="6dp"
                android:background="#FFFFFF"
                android:padding="4dp"
                android:layout_marginBottom="24dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <include layout="@layout/layout_bottom_nav"/>

</LinearLayout>
